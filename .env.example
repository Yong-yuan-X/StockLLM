# Copy this file to .env and fill local secrets there.
# .env is ignored by git.

FLASK_DEBUG=false
PORT=5001
DATABASE_PATH=stock.db
ENABLE_REPORT_SCHEDULER=true
FLASK_SECRET_KEY=
SESSION_COOKIE_SECURE=false
MAX_UPLOAD_SIZE_MB=10
ENABLE_TEST_ENDPOINTS=false
ENABLE_SENTIMENT_DEBUG=false

# Docker deployment. Keep these paths on the server, not in git.
APP_IMAGE=ghcr.io/your-github-user/stockllm:latest
WEB_PORT=443
HOST_RUNTIME_DIR=./runtime
HOST_DATABASE_PATH=./stock.db
HOST_CERT_DIR=./certs

ADMIN_USERNAME=admin
ADMIN_PASSWORD=

MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=false
MAIL_USE_SSL=true
MAIL_FROM_NAME=StockLLM
MAIL_FROM_ADDRESS=

REPORT_LLM_PROVIDER=xiaomi
REPORT_ENABLE_WEB_SEARCH=false

ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-2-0-lite-260215
ARK_API_KEY=

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=

QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.5-plus
QWEN_API_KEY=

XIAOMI_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
XIAOMI_MODEL=mimo-v2.5-pro
XIAOMI_API_KEY=
